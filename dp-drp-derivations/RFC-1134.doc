                <td id="customfield_10074-336217-value" class="value" bgcolor="#ffffff" width="80%">            <span title="04/Nov/25 9:00 AM"><time class="livestamp allow-future" datetime="2025-11-04T09:00:00-0700">04/Nov/25 9:00 AM</time></span>
